# Copy to .env (backend) and frontend/.env.local (frontend). Never commit real values.

# ---- Backend (server only) ----
# Optional but strongly recommended: raises the GitHub API limit from 60 to 5,000 requests/hour.
# Use a fine-grained token with NO repository access selected (public data only).
GITHUB_TOKEN=
# Optional: persist shared reports in Supabase. Leave empty to use in-memory storage.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Cache analysis results for this many seconds (fewer GitHub calls).
CACHE_TTL_SECONDS=900
# Analyses allowed per client IP per minute.
RATE_LIMIT_PER_MINUTE=20
# Set to 1 behind a reverse proxy or the Next.js server, so rate limits use the real client IP.
TRUST_PROXY=0
# Comma-separated origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend (server only) ----
# Where the Next.js server proxies /api requests.
REPORADAR_API_URL=http://localhost:8000
